# ==============================================================================
# Digital Detective — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and adjust variables to match your local setup.
# Never commit real credentials or private API keys to version control.

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
LOG_LEVEL=INFO

# Dataset & Benchmark Paths
# Directory containing cached RCAEval parquet files (e.g. re2ob_checkoutservice_cpu_1)
RCAEVAL_DATASET_ROOT=~/.cache/rcaeval_validation

# RAG & Knowledge Base Configuration
RUNBOOK_CORPUS_PATH=data/rag/runbooks_canonical.jsonl
BGE_CACHE_DIR=data/rag/cache

# LLM & Investigator Agent Backend
# Supported backends: 'mock' (offline deterministic heuristic), 'ollama' (local LLM), 'grok'
INVESTIGATOR_BACKEND=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# RCA & Disambiguation Thresholds
# Score margin (Delta = s_(1) - s_(2)) below which candidate disambiguation is triggered
DISAMBIGUATION_MARGIN_THRESHOLD=0.05

# Safety Gate Configuration
# If TRUE, remediation execution is dry-run only unless human approval is explicitly granted
SAFETY_DEFAULT_DRY_RUN=true
