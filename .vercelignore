# Vercel deployment ignore: publish only static frontend assets in src/digital_detective/web/
.*
!.vercelignore
data/
eval/
experiments/
models/
scripts/
tests/
outputs/
artifacts/
scratch/
docs/
src/digital_detective/agent/
src/digital_detective/api/
src/digital_detective/detective/
src/digital_detective/features/
src/digital_detective/rag/
src/digital_detective/*.py
*.py
*.parquet
*.pkl
*.json
*.jsonl
*.md
requirements.txt
pyproject.toml
render.yaml
